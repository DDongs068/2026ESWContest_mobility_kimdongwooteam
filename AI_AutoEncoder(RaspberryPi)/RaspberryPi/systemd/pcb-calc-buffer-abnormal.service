# Pi 계정이 pi 가 아니면 pi 와 /home/pi 를 바꿔 주세요.
[Unit]
Description=Abnormal data -> live LibreOffice Calc buffer (10 rows)
After=graphical-session.target pcb-calc-buffer.service

[Service]
WorkingDirectory=/home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/python3 -u /home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay/calc_buffer.py --label 비정상 --port 5012
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
