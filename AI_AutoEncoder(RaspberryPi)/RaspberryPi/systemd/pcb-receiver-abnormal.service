# Pi 계정이 pi 가 아니면 pi 와 /home/pi 를 바꿔 주세요.
[Unit]
Description=Abnormal data receiver (127.0.0.1:5013) -> Calc buffer 5012
After=network.target pcb-ack-gate.service

[Service]
WorkingDirectory=/home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay
ExecStart=/usr/bin/python3 -u /home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay/receiver.py --port 5013 --allow-net 127.0.0.1/32 --data-dir /home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay/data_abnormal --forward 127.0.0.1:5012
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
