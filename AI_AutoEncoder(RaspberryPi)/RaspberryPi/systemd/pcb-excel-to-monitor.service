# Pi 계정이 pi 가 아니면 pi 와 /home/pi 를 바꿔 주세요.
[Unit]
Description=Excel(normal) 10-row blocks -> AE monitor (UDP 5005)
After=pcb-calc-buffer.service aibms-monitor.service

[Service]
WorkingDirectory=/home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay
ExecStart=/usr/bin/python3 -u /home/pi/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder(RaspberryPi)/RaspberryPi/relay/excel_to_monitor.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
