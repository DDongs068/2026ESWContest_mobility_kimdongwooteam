[Unit]
Description=PCB -> Pi measurement receiver (UDP 5001)
After=network.target NetworkManager.service

[Service]
User=rpi4
WorkingDirectory=/home/rpi4/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder/RaspberryPi/relay
ExecStart=/usr/bin/python3 -u /home/rpi4/2026ESWContest_mobility_kimdongwooteam/AI_AutoEncoder/RaspberryPi/relay/receiver.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
